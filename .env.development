# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# Single .env file cho cả development và production
# 
# Build commands tự động detect environment:
#   npm run dev                    → development (VITE_DEV_* URLs)
#   npm run build                  → production (VITE_PROD_* URLs)
#   npm run build --mode development → development build
# ==========================================

# ==========================================
# CURRENT ENVIRONMENT
# ==========================================
# Auto-detected by Vite based on --mode flag
# development: npm run dev, npm run build:dev
# production: npm run build
# ==========================================

# VITE_APP_ENV=development  # Optional: force override

# ==========================================
# BRAND / THEME (alliance | quocnam)
# ==========================================
# Dev mặc định dùng theme Alliance (xanh dương).
# Bỏ comment để ép brand khác khi dev/test:
 VITE_BRAND=alliance

# ==========================================
# MOBILE APP LINKS
# ==========================================
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# ==========================================
# DEVELOPMENT ENVIRONMENT - API ENDPOINTS
# ==========================================
VITE_SIGNALR_LOG_LEVEL=Warning

# Chat Service (Development)
VITE_DEV_CHAT_API_URL= https://vega-chat-api-dev.allianceitsc.com

# Auth/Identity Service (Development)
VITE_DEV_AUTH_API_URL = https://vega-identity-api-dev.allianceitsc.com
# Task Service (Development) - Optional
VITE_DEV_TASK_API_URL = https://vega-task-api-dev.allianceitsc.com

# File Service (Development)
VITE_DEV_FILE_API_URL= https://vega-file-api-dev.allianceitsc.com

# Fingerprint Agent (local desktop helper) - fallback: http://localhost:52100/fingerprint
# VITE_FINGERPRINT_URL=http://localhost:52100/fingerprint

# ==========================================
# PRODUCTION ENVIRONMENT - API ENDPOINTS
# ==========================================

# Chat Service (Production)
VITE_PROD_CHAT_API_URL= https://test-qnchat-api.quocnam.net

# Auth/Identity Service (Production)
VITE_PROD_AUTH_API_URL= https://test-qnid-api.quocnam.net

# Task Service (Production) - Optional
VITE_PROD_TASK_API_URL= https://test-qntask-api.quocnam.net

# File Service (Production)
VITE_PROD_FILE_API_URL= https://test-qnfile-api.quocnam.net

# ==========================================
# FEATURE FLAGS (Environment-specific)
# ==========================================

# Development Feature Flags
VITE_DEV_ENABLE_SIGNALR=true
VITE_DEV_ENABLE_DEBUG_LOGS=true
VITE_DEV_ENABLE_REACT_QUERY_DEVTOOLS=true

# Production Feature Flags
VITE_PROD_ENABLE_SIGNALR=true
VITE_PROD_ENABLE_DEBUG_LOGS=false
VITE_PROD_ENABLE_REACT_QUERY_DEVTOOLS=false

# Shared UI Feature Flags
# Hiển thị avatar thành viên trong nhóm (mặc định false). Đặt =true để bật.
VITE_SHOW_MEMBER_AVATAR=false

# Tính năng "Xác nhận tin nhắn" (multi-user ack). Mặc định BẬT.
# Đặt =false để ẩn hoàn toàn (nút hover + pill) — vd brand Alliance chat.
VITE_ENABLE_MESSAGE_CONFIRM=true

# Tính năng "Thả cảm xúc tin nhắn" (reaction). Mặc định TẮT (opt-in).
# Đặt =true để hiển thị nút thả ở góc bubble + thanh chip cảm xúc.
VITE_ENABLE_MESSAGE_REACTION=true

# ==========================================
# SIGNALR HUB URLs (for realtime)
# ==========================================
# SignalR Hub uses the Chat API base URL + /hubs/chat

# Development SignalR Hub
VITE_DEV_SIGNALR_HUB_URL= https://vega-chat-api-dev.allianceitsc.com/hubs/chat
# https://localhost:7146/hubs/chat

# Production SignalR Hub
VITE_PROD_SIGNALR_HUB_URL=https://vega-chat-api.allianceitsc.com/hubs/chat

# ==========================================
# EXTERNAL LINKS
# ==========================================
VITE_GUIDE_URL=https://quoc-nam-guide.vercel.app
VITE_GUIDE_JWT_SECRET=quocnam-guide-default-secret

# ==========================================
# SECURITY FEATURES (Disabled for Development)
# ==========================================
# ⚠️ DEFAULT: All protections ENABLED in production (secure by default)
# Explicitly set to "false" in development to allow debugging

# MASTER FLAG - Tắt TOÀN BỘ protections cùng lúc
# Set false để tắt tất cả, true để bật (từng flag riêng vẫn hoạt động)
VITE_DEV_ENABLE_ALL_PROTECTIONS=true

# DevTools Protection - Set false to allow F12, DevTools
VITE_DEV_ENABLE_DEVTOOLS_PROTECTION=false

# Context Menu Protection - Set false to allow right-click inspect
VITE_DEV_ENABLE_CONTEXT_MENU_PROTECTION=true

# Content Protection - Set false to allow copy/select
VITE_DEV_ENABLE_CONTENT_PROTECTION=true

# Print Protection - Chặn Ctrl+P (true = chặn, false = cho phép)
VITE_DEV_ENABLE_PRINT_PROTECTION=true

# Save Protection - Chặn Ctrl+S (true = chặn, false = cho phép)
VITE_DEV_ENABLE_SAVE_PROTECTION=true

# Production security (không cần set - mặc định enabled)
# VITE_PROD_ENABLE_DEVTOOLS_PROTECTION=true (optional - default enabled)
# VITE_PROD_ENABLE_CONTEXT_MENU_PROTECTION=true (optional - default enabled)
# VITE_PROD_ENABLE_CONTENT_PROTECTION=true (optional - default enabled)

# Whitelist emails - Users who bypass ALL protections (for production debugging)
# Example: admin@company.com,dev@company.com
VITE_SECURITY_WHITELIST_EMAILS=admin@quoc-nam.com,asuna@test.vega,spirit@test.vega

# ==========================================
# FILE UPLOAD LIMITS (in MB)
# ==========================================
# Default: Image = 10MB, Video = 20MB, Other files = 10MB, Total = 100MB
# VITE_MAX_IMAGE_SIZE_MB=10
# VITE_MAX_VIDEO_SIZE_MB=20
# VITE_MAX_FILE_SIZE_MB=10
# VITE_MAX_TOTAL_SIZE_MB=100

# ==========================================
# FILE ALLOWED TYPES (comma-separated)
# ==========================================
# MIME types - Nếu không set thì dùng default
# VITE_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# VITE_ALLOWED_SPREADSHEET_TYPES=application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
# VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/heic,image/heif
# VITE_ALLOWED_VIDEO_TYPES=video/mp4

# File extensions cho <input accept> - Nếu không set thì dùng default
VITE_ALLOWED_FILE_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.webp,.heic,.heif,.mp4,.HEIC
# VITE_ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.heic,.heif
