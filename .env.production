# ==========================================
# PRODUCTION BUILD - Test Site (quocnam.net)
# ==========================================
# Build command: npm run build
# ==========================================

# Force production environment
VITE_APP_ENV=production

# ==========================================
# BRAND / THEME (alliance | quocnam)
# ==========================================
# Live mặc định dùng theme Quốc Nam (xanh lá)
VITE_BRAND=quocnam

# ==========================================
# MOBILE APP LINKS
# ==========================================
VITE_APP_STORE_URL=#
VITE_GOOGLE_PLAY_URL=#

# ==========================================
# PRODUCTION API ENDPOINTS
# ==========================================
VITE_PROD_CHAT_API_URL=https://test-qnchat-api.quocnam.net
VITE_PROD_AUTH_API_URL=https://test-qnid-api.quocnam.net
VITE_PROD_TASK_API_URL=https://test-qntask-api.quocnam.net
VITE_PROD_FILE_API_URL=https://test-qnfile-api.quocnam.net

# Fingerprint Agent (local desktop helper) - fallback: http://localhost:52100/fingerprint
# VITE_FINGERPRINT_URL=http://localhost:52100/fingerprint

# ==========================================
# SIGNALR HUB (auto-derived from Chat API)
# ==========================================
VITE_PROD_SIGNALR_HUB_URL=https://test-qnchat-api.quocnam.net/hubs/chat

# ==========================================
# FEATURE FLAGS
# ==========================================
VITE_PROD_ENABLE_SIGNALR=true
VITE_PROD_ENABLE_DEBUG_LOGS=false
VITE_PROD_ENABLE_REACT_QUERY_DEVTOOLS=false

# Hiển thị avatar thành viên trong nhóm (mặc định false). Đặt =true để bật.
VITE_SHOW_MEMBER_AVATAR=false

# ==========================================
# SECURITY (all enabled by default in production)
# ==========================================
# Uncomment to disable specific protections on test site:
# VITE_PROD_ENABLE_ALL_PROTECTIONS=false
# VITE_PROD_ENABLE_DEVTOOLS_PROTECTION=false

VITE_SECURITY_WHITELIST_EMAILS=admin@quoc-nam.com,ngocminh@allianceitsc.com,ngocminh2@allianceitsc.com

# ==========================================
# EXTERNAL LINKS
# ==========================================
VITE_GUIDE_URL=https://quoc-nam-guide.vercel.app

# ==========================================
# FILE UPLOAD LIMITS (in MB)
# ==========================================
# Default: Image = 10MB, Video = 20MB, Other files = 10MB, Total = 100MB
# VITE_MAX_IMAGE_SIZE_MB=10
# VITE_MAX_VIDEO_SIZE_MB=20
# VITE_MAX_FILE_SIZE_MB=10
# VITE_MAX_TOTAL_SIZE_MB=100
