# Local Environment Overrides
# 
# Copy this file to .env.local and customize for your local development
# .env.local is gitignored - never commit it to version control

# ==========================================
# Local API Overrides (Optional)
# ==========================================

# Override Chat API for local development
# VITE_CHAT_API_BASE_URL=http://localhost:5000

# Override Task API for local development
# VITE_TASK_API_BASE_URL=http://localhost:5001

# Override Fingerprint Agent URL (local desktop helper)
# Fallback trong code: http://localhost:52100/fingerprint
# VITE_FINGERPRINT_URL=http://localhost:52100/fingerprint

# ==========================================
# Brand / Theme Override (Optional)
# ==========================================
# Chọn theme: alliance (xanh dương) | quocnam (xanh lá)
# Default: dev → alliance, live → quocnam
# VITE_BRAND=quocnam

# ==========================================
# Local Feature Flags (Optional)
# ==========================================

# ==========================================
# Mobile App Links (Optional override)
# ==========================================
# VITE_APP_STORE_URL=https://apps.apple.com/app/...
# VITE_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=...

# VITE_ENABLE_SIGNALR=false
# VITE_ENABLE_OFFLINE_MODE=true
# VITE_ENABLE_DEBUG_LOGS=true

# ==========================================
# Security Features (Client-Side Protection)
# ⚠️ DEFAULT: ALL PROTECTIONS ARE ENABLED
# Không cần config gì - production tự động bật!
# Chỉ set "false" nếu muốn tắt cho development
# ==========================================

# MASTER FLAG - Tắt TOÀN BỘ protections cùng lúc
# ✅ Default: ENABLED (không cần uncomment)
# Chỉ uncomment dòng dưới nếu muốn TẮT TẤT CẢ:
# VITE_DEV_ENABLE_ALL_PROTECTIONS=false

# DevTools Protection - Blocks F12, Ctrl+Shift+I, etc.
# ✅ Default: ENABLED (không cần uncomment)
# Chỉ uncomment dòng dưới nếu muốn TẮT cho dev:
# VITE_DEV_ENABLE_DEVTOOLS_PROTECTION=false

# Context Menu Protection - Blocks right-click inspect
# ✅ Default: ENABLED (không cần uncomment)
# Chỉ uncomment dòng dưới nếu muốn TẮT cho dev:
# VITE_DEV_ENABLE_CONTEXT_MENU_PROTECTION=false

# Content Protection - Prevents copy/select in file previews
# ✅ Default: ENABLED (không cần uncomment)
# Chỉ uncomment dòng dưới nếu muốn TẮT cho dev:
# VITE_DEV_ENABLE_CONTENT_PROTECTION=false

# ==========================================
# External Links (Optional Override)
# ==========================================

# Guide URL - Override nếu cần test local
# VITE_GUIDE_URL=https://quoc-nam-guide.vercel.app

# Print Protection - Blocks Ctrl+P (Print page)
# ✅ Default: ENABLED (không cần uncomment)
# Chỉ uncomment dòng dưới nếu muốn TẮT:
# VITE_DEV_ENABLE_PRINT_PROTECTION=false

# Save Protection - Blocks Ctrl+S (Save page)
# ✅ Default: ENABLED (không cần uncomment)
# Chỉ uncomment dòng dưới nếu muốn TẮT:
# VITE_DEV_ENABLE_SAVE_PROTECTION=false

# ==========================================
# File Upload Limits (in MB, Optional Override)
# ==========================================
# Default: Image = 10MB, Video = 20MB, Other files = 10MB, Total = 100MB
# VITE_MAX_IMAGE_SIZE_MB=10
# VITE_MAX_VIDEO_SIZE_MB=20
# VITE_MAX_FILE_SIZE_MB=10
# VITE_MAX_TOTAL_SIZE_MB=100

# File types to protect (comma-separated, no spaces)
VITE_CONTENT_PROTECTION_FILE_TYPES=pdf,doc,docx,xlsx,xls,png,jpg,jpeg

# Whitelist emails - Users who bypass all protections (comma-separated)
# Example: admin@company.com,dev@company.com
VITE_SECURITY_WHITELIST_EMAILS=admin@quoc-nam.com

# ==========================================
# Test Credentials (for AI snapshot capture)
# ⚠️ NEVER use production credentials here
# ==========================================

# TEST_EMAIL=test@example.com
# TEST_PASSWORD=test_password_here
